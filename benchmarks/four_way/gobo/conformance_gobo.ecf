<?xml version="1.0" encoding="UTF-8"?>
<!-- Four-way comparison: the dual-W3C xpact conformance harness compiled with the Gobo Eiffel compiler (gec).
     Same parser source, backend and shared harness as benchmarks/dual_w3c/xpact; Gobo's FreeELKS base library. -->
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-20-0" name="xpact_w3c_conformance_gobo" uuid="5B0D6F2E-8C1A-4D7B-9E31-2F4A6C8B1D07">
	<target name="conformance_assertions">
		<root class="DW_CONFORMANCE_ROOT" feature="make"/>
		<option warning="true">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<setting name="console_application" value="true"/>
		<setting name="dead_code_removal" value="all"/>
		<capability>
			<concurrency support="none"/>
			<void_safety support="all" use="all"/>
		</capability>
		<external_cflag value="-O2"/>
		<library name="base" location="$GOBO/library/free_elks/library.ecf">
			<option>
				<assertions precondition="false" postcondition="false" check="false" invariant="false" loop="false" supplier_precondition="false"/>
			</option>
		</library>
		<cluster name="parser" location="$XPACT_SOURCE_ROOT/src/"/>
		<cluster name="backend" location="$XPACT_SOURCE_ROOT/benchmarks/dual_w3c/xpact/"/>
		<cluster name="shared" location="$XPACT_SOURCE_ROOT/benchmarks/dual_w3c/shared/"/>
		<cluster name="identity" location="$XPACT_PROBE_METADATA/"/>
	</target>
</system>