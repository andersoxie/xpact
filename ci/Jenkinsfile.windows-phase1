def publishDualImplementationResults(outputDir, buildId) {
  if (!outputDir || !buildId) {
    return
  }
  if (!(outputDir ==~ /build\/dual-ci-[0-9]+-[0-9]+/)) {
    error('Invalid current dual-implementation output directory')
  }
  if (!fileExists("${outputDir}/run.json")) {
    echo 'No current dual-implementation campaign state was created.'
    return
  }
  withEnv(["DUAL_PUBLICATION_DIR=${outputDir}", "DUAL_PUBLICATION_BUILD_ID=${buildId}"]) {
    powershell '''
      $ErrorActionPreference = 'Stop'
      $State = Get-Content -LiteralPath (Join-Path $env:DUAL_PUBLICATION_DIR 'run.json') -Raw | ConvertFrom-Json
      if ($State.build_id -cne $env:DUAL_PUBLICATION_BUILD_ID) {
        throw 'Dual-implementation output belongs to a different Jenkins build.'
      }
    '''
  }
  try {
    def readiness
    withEnv(["DUAL_PUBLICATION_DIR=${outputDir}"]) {
      readiness = powershell(returnStdout: true, script: '''
        $ErrorActionPreference = 'Stop'
        $State = Get-Content -LiteralPath (Join-Path $env:DUAL_PUBLICATION_DIR 'run.json') -Raw | ConvertFrom-Json
        $PlotsReady = 0
        if ($State.status -in @('complete', 'complete_with_failures', 'failed') -and $State.publication) {
          if (-not (Test-Path -LiteralPath (Join-Path $env:DUAL_PUBLICATION_DIR 'plots.tsv') -PathType Leaf) -or
              -not (Test-Path -LiteralPath (Join-Path $env:DUAL_PUBLICATION_DIR 'dual-implementation-plots.html') -PathType Leaf)) {
            throw 'Current dual-implementation publication is incomplete.'
          }
          $PlotsReady = 1
        }
        $SubjectReady = 0
        if ($State.status -in @('complete', 'complete_with_failures', 'failed') -and $State.subject_summary) {
          if ($State.subject_summary.status -notin @('complete', 'complete_with_failures', 'failed') -or
              $State.subject_summary.implementation -cne 'xpact' -or
              $State.subject_summary.junit -cne 'xpact-junit.xml' -or
              -not (Test-Path -LiteralPath (Join-Path $env:DUAL_PUBLICATION_DIR 'xpact-junit.xml') -PathType Leaf)) {
            throw 'Current xpact test summary is incomplete or invalid.'
          }
          $SubjectReady = 1
        }
        Write-Output ("{0}`t{1}" -f $PlotsReady, $SubjectReady)
      ''').trim()
    }
    def flags = readiness.split('\\t', -1)
    if (flags.size() != 2 || !(flags[0] in ['0', '1']) || !(flags[1] in ['0', '1'])) {
      error('Invalid dual-implementation publication readiness')
    }
    if (flags[1] == '1') {
      // Reference-parser outcomes remain in plots/artifacts, outside Jenkins' test totals.
      junit testResults: "${outputDir}/xpact-junit.xml", allowEmptyResults: false
    }
    if (flags[0] == '1') {
      def text = readFile("${outputDir}/plots.tsv").replaceFirst(/^\uFEFF/, '')
      def lines = text.split(/\r?\n/).findAll { it.trim().length() > 0 }
      if (lines.isEmpty()) {
        error('Current dual-implementation plot manifest is empty')
      }
      def headers = parseTsvLine(lines[0])
      if (headers != ['sourceFile', 'csvFileName', 'group', 'title', 'yaxis']) {
        error('Invalid dual-implementation plot manifest columns')
      }
      def plots = []
      lines.drop(1).each { line ->
        def values = parseTsvLine(line)
        if (values.size() != headers.size()) {
          error('Invalid dual-implementation plot manifest row')
        }
        def spec = [:]
        headers.eachWithIndex { header, index -> spec[header] = values[index] }
        if (!spec.sourceFile.startsWith("${outputDir}/") || spec.sourceFile.contains('..') ||
            !(spec.csvFileName ==~ /[A-Za-z0-9_.-]+\.csv/)) {
          error('Dual-implementation plot references output outside this campaign')
        }
        plots << spec
      }
      publishBenchmarkPlots(plots)
      publishBenchmarkHtmlReport(outputDir, 'dual-implementation-plots.html', 'Dual Implementation Plots',
                                 'dual-implementation-plots.html,*.csv,plots.tsv,run.json,xpact-summary.json,xpact-junit.xml,catalog/report.json,catalog/summary.md,w3c/report.json,w3c/summary.md')
      linkBenchmarkReportInBuildDescription("${outputDir}/dual-implementation-plots.html", 'Dual Implementation Plots')
    } else {
      echo 'Dual-implementation campaign has no completed plot publication; preserving current diagnostics.'
    }
  } finally {
    archiveArtifacts artifacts: "${outputDir}/**/*.json,${outputDir}/**/*.tsv,${outputDir}/**/*.csv,${outputDir}/**/*.html,${outputDir}/**/*.md,${outputDir}/**/*.xml,${outputDir}/**/*.log,${outputDir}/**/stdout.bin,${outputDir}/**/stderr.bin",
                     excludes: "${outputDir}/**/project/**,${outputDir}/**/suite/**",
                     allowEmptyArchive: true
  }
}

def notifyBuildResultByEmail() {
  def result = currentBuild.currentResult
  if (!(result in ['FAILURE', 'UNSTABLE'])) {
    return
  }
  def recipients = (params.EMAIL_RECIPIENTS ?: '').trim()
  if (!recipients) {
    echo 'EMAIL_RECIPIENTS is empty; skipping the build-result email.'
    return
  }
  catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS', catchInterruptions: false,
             message: 'Could not send the build-result email; preserving the original build result.') {
    mail to: recipients,
         subject: "${env.JOB_NAME} #${env.BUILD_NUMBER}: ${result}",
         body: """Result: ${result}
Build: ${env.JOB_NAME} #${env.BUILD_NUMBER}
Build page: ${env.BUILD_URL}
Console: ${env.BUILD_URL}console
"""
  }
}

