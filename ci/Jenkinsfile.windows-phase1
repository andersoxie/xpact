def linkBenchmarkReportInBuildDescription(artifactPath, label) {
  def baseUrl = env.BUILD_URL ?: ''
  def reportUrl = "${baseUrl}artifact/${artifactPath}"
  def link = "${label}: ${reportUrl}"
  def previousDescription = currentBuild.description?.trim()
  currentBuild.description = previousDescription ? "${previousDescription}\n${link}" : link
}

