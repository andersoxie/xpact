            catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
              runWithJenkinsTestResult('CPython public application tests', 'source tree available for xpact replacement') {
                error "Skipping CPython xpact replacement: CPYTHON_SOURCE_DIR is not a CPython checkout with PCbuild\\build.bat: ${env.CPYTHON_SOURCE_DIR}"
              }
            }
          } else {
            runWithJenkinsTestResult('CPython public application tests', 'xpact replacement XML suite') {
              powershell '''
                $ErrorActionPreference = "Stop"
                Write-Host "Apply the maintained CPython pyexpat-to-xpact patch here."
                Write-Host "The patch should link pyexpat against ${env:XPACT_LIBRARY}"
                Write-Host "and copy build\\native-eiffel\\xpact.dll beside the test interpreter."
                throw "CPython xpact replacement patch is not installed yet."
              '''
            }
          }
        }
      }
      post {
        always {
          script {
            publishJenkinsTestResults()
          }
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: '''
        build/native-eiffel/xpact.dll,
        build/native-eiffel/xpact.lib,
        build/native-eiffel/xpact_assertions.dll,
        build/native-eiffel/xpact_assertions.lib,
        build/chunked-crc/*.tsv,
        build/incremental-shim-audit/*.tsv,
        build/libexpat-adapter-current/*.tsv,
        build/libexpat-adapter-current/*.log,
        build/contributed-examples/*.log,
        build/benchmarks/*.tsv,
        build/benchmarks/*.csv,
        build/benchmarks/*.html,
        build/benchmarks/w3c-xml-conformance/*.tsv,
        build/benchmarks/w3c-xml-conformance/*.json,
        build/benchmarks/w3c-xml-conformance/*.md,
        build/benchmarks/w3c-xml-conformance/*.xml,
        docs/benchmarks.md,
        docs/performance-analysis.md,
        dist/*.zip
      ''', allowEmptyArchive: true
    }
    cleanup {
      script {
        notifyBuildResultByEmail()
      }
    }
  }
}
