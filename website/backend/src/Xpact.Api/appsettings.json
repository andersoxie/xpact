{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Xpact": {
    "WorkerPath": "Xpact.Worker.exe",
    "Builds": {
      "production": "native/xpact.dll",
      "assertions": "native/xpact_assertions.dll"
    },
    "MaxDocumentBytes": 10485760,
    "TimeoutSeconds": 10,
    "WorkerMemoryMb": 512,
    "WorkerLowIntegrity": true,
    "MaxConcurrentWorkers": 4,
    "MaxWorkersPerClient": 2,
    "QueueWaitSeconds": 15,
    "MaxQueuedRequests": 32,
    "RequestsPerMinute": 30,
    "MaxEvents": 200,
    "MinChunkSize": 1,
    "KnownProxies": [],
    "KnownNetworks": [],
    "DataDirectory": "data"
  }
}
