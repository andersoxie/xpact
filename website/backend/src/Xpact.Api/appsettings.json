{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Xpact": {
    "WorkerPath": "Xpact.Worker.exe",
    "Builds": {
      "production": "native/xpact.dll",
      "assertions": "native/xpact_assertions.dll"
    },
    "MaxDocumentBytes": 1048576,
    "TimeoutSeconds": 10,
    "WorkerMemoryMb": 512,
    "MaxConcurrentWorkers": 4,
    "RequestsPerMinute": 30,
    "MaxEvents": 200,
    "MinChunkSize": 1,
    "KnownProxies": [],
    "DataDirectory": "data"
  }
}
