<?xml version="1.0" encoding="UTF-8"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-20-0" name="mt_parse_test_gobo" uuid="7C3D9E2A-4F1B-4B8E-9A6D-304304304305">
	<!-- Same test as mt_parse_test.ecf, compiled with Gobo Eiffel (gec, Boehm GC) instead of EiffelStudio. -->
	<target name="mt_parse_test_gobo">
		<root class="XP_MT_PARSE_TEST" feature="make"/>
		<option warning="true">
			<assertions precondition="false" postcondition="false" check="false" invariant="false" loop="false" supplier_precondition="false"/>
		</option>
		<setting name="console_application" value="true"/>
		<setting name="dead_code_removal" value="all"/>
		<capability>
			<concurrency support="thread"/>
			<void_safety support="all" use="all"/>
		</capability>
		<library name="base" location="$GOBO/library/free_elks/library.ecf">
			<option>
				<assertions precondition="false" postcondition="false" check="false" invariant="false" loop="false" supplier_precondition="false"/>
			</option>
		</library>
		<library name="thread" location="$GOBO/library/thread/library.ecf"/>
		<cluster name="parser" location="../../../src/">
			<file_rule>
				<exclude>/xp_native_</exclude>
				<exclude>/xp_cli\.e$</exclude>
			</file_rule>
		</cluster>
		<cluster name="test" location="./">
			<file_rule>
				<exclude>/EIFGENs$</exclude>
			</file_rule>
		</cluster>
	</target>
</system>
