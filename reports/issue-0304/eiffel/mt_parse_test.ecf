<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-20-0" name="mt_parse_test" uuid="7C3D9E2A-4F1B-4B8E-9A6D-304304304304">
	<target name="mt_parse_test">
		<root class="XP_MT_PARSE_TEST" feature="make"/>
		<option warning="true">
			<assertions precondition="false" postcondition="false" check="false" invariant="false" loop="false" supplier_precondition="false"/>
		</option>
		<setting name="console_application" value="true"/>
		<setting name="dead_code_removal" value="all"/>
		<setting name="inlining" value="true"/>
		<setting name="inlining_size" value="4"/>
		<capability>
			<concurrency support="thread"/>
			<void_safety support="all" use="all"/>
		</capability>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
		<library name="thread" location="$ISE_LIBRARY\library\thread\thread.ecf"/>
		<cluster name="parser" location="..\..\..\src\">
			<file_rule>
				<exclude>/xp_native_</exclude>
				<exclude>/xp_cli\.e$</exclude>
			</file_rule>
		</cluster>
		<cluster name="test" location=".\"/>
	</target>
</system>
