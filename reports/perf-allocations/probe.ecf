<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-20-0" name="alloc_probe" uuid="5A1E0C3B-6D2F-4E9A-8B7C-A110CA7E0001">
	<target name="alloc_probe">
		<root class="XP_ALLOC_PROBE" feature="make"/>
		<option warning="true">
			<assertions precondition="false" postcondition="false" check="false" invariant="false" loop="false" supplier_precondition="false"/>
		</option>
		<setting name="console_application" value="true"/>
		<setting name="dead_code_removal" value="all"/>
		<setting name="inlining" value="true"/>
		<setting name="inlining_size" value="4"/>
		<setting name="array_optimization" value="true"/>
		<capability>
			<concurrency support="none"/>
			<void_safety support="all" use="all"/>
		</capability>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
		<library name="time" location="$ISE_LIBRARY\library\time\time.ecf"/>
		<cluster name="parser" location="..\..\src\">
			<file_rule>
				<exclude>/xp_native_</exclude>
				<exclude>/xp_cli\.e$</exclude>
			</file_rule>
		</cluster>
		<cluster name="probe" location=".\"/>
	</target>
</system>
