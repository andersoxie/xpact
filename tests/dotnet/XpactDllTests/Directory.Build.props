<Project>
  <!-- Keep bin/ and obj/ out of the source tree: build/ is ignored by git. -->
  <PropertyGroup>
    <XpactRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..'))</XpactRoot>
    <BaseOutputPath>$(XpactRoot)\build\dotnet\XpactDllTests\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(XpactRoot)\build\dotnet\XpactDllTests\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
